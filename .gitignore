# =============================================================================
#  UAV Technologies - repo-wide .gitignore
#  Covers: ESP-IDF, Arduino (IDE / arduino-cli), PlatformIO, STM32 (CubeIDE,
#  CubeMX, Keil MDK, IAR, Makefile/CMake), generic C/C++, Python, LaTeX, OS.
#  NOTE: gitignore has no inline comments - a "# ..." after a pattern becomes
#  part of the pattern. Always put comments on their own line.
# =============================================================================

# ===== Generic build output =====
build/
build_*/
cmake-build-*/
out/
bin/
obj/

# Object files / libraries / dependency files
*.o
*.obj
*.a
*.lib
*.so
*.d
*.su
*.cyclo
*.gch
*.pch

# Firmware images & linker output
*.elf
*.axf
*.bin
*.hex
*.srec
*.map
*.lst
*.list
*.dis

# Host-side executables
*.exe
*.out
*.app

# ===== CMake =====
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CMakeUserPresets.json
Testing/

# ===== ESP-IDF =====
# Board-specific config generated by menuconfig. Shared defaults belong in
# sdkconfig.defaults (which IS tracked).
sdkconfig
sdkconfig.old
# Component manager downloads
managed_components/
dependencies.lock
# Locally installed toolchain (if any)
.espressif/
flasher_args.json

# ===== Arduino =====
# arduino-cli --export-binaries / Arduino IDE 2 build outputs inside sketch dir
*.ino.bin
*.ino.hex
*.ino.elf
*.ino.map
*.ino.with_bootloader.*
*.ino.merged.bin
*.ino.bootloader.bin
*.ino.partitions.bin
# arduino-cli local config/cache
.arduino15/
arduino-cli.yaml
# Arduino IDE 2 per-sketch debug config (machine specific)
debug_custom.json

# ===== PlatformIO =====
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ===== STM32CubeIDE / Eclipse =====
# Build configurations
Debug/
Release/
# Workspace metadata (never commit) - keep .project, .cproject, .mxproject, *.ioc
.metadata/
RemoteSystemsTempFiles/
.settings/language.settings.xml
*.launch.bak
# CubeMX backup / generated reports
*.ioc.bak
.mxproject.bak
MXTmpFiles/

# ===== Keil MDK (uVision) =====
*.uvguix.*
*.uvgui.*
*.uvoptx.bak
*.uvprojx.bak
*.dep
*.crf
*.lnp
*.iex
*.htm
*.build_log.htm
*.sct.bak
*.scvd
JLinkLog.txt
JLinkSettings.ini
EventRecorderStub.scvd
Objects/
Listings/
RTE/_*/

# ===== IAR EWARM =====
settings/
*.dep
*.ewt.bak
Exe/
List/
Obj/
BrowseInfo/

# ===== Segger / debuggers =====
*.jdebug.user
.gdb_history

# ===== Editors / IDEs =====
# VS Code: contains machine-specific paths (ESP-IDF install, COM port)
.vscode/
.idea/
*.swp
*.swo
*~
*.user
*.suo
*.sln.docstates
.vs/

# clangd / language server caches
.cache/
.clangd/
.ccls-cache/
compile_commands.json

# ===== Python / Jupyter =====
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ===== LaTeX =====
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.xdv

# ===== OS =====
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
.directory

# ===== Misc =====
*.log
*.tmp
*.bak
*.orig
